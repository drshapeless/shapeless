/**
* Selector constants for u_charName().
* u_charName() returns the "modern" name of a
* Unicode character; or the name that was defined in
* Unicode version 1.0, before the Unicode standard merged
* with ISO-10646; or an "extended" name that gives each
* Unicode code point a unique name.
*
* @see u_charName
* @stable ICU 2.0
*/
UCharNameChoice :: enum u32 {
    UNICODE_CHAR_NAME      :: 0;

    UNICODE_10_CHAR_NAME   :: 1;

    EXTENDED_CHAR_NAME     :: 2;

    CHAR_NAME_ALIAS        :: 3;

    CHAR_NAME_CHOICE_COUNT :: 4;

    U_UNICODE_CHAR_NAME      :: UNICODE_CHAR_NAME;

    U_UNICODE_10_CHAR_NAME   :: UNICODE_10_CHAR_NAME;

    U_EXTENDED_CHAR_NAME     :: EXTENDED_CHAR_NAME;

    U_CHAR_NAME_ALIAS        :: CHAR_NAME_ALIAS;

    U_CHAR_NAME_CHOICE_COUNT :: CHAR_NAME_CHOICE_COUNT;
}

/**
* Selector constants for u_getPropertyName() and
* u_getPropertyValueName().  These selectors are used to choose which
* name is returned for a given property or value.  All properties and
* values have a long name.  Most have a short name, but some do not.
* Unicode allows for additional names, beyond the long and short
* name, which would be indicated by U_LONG_PROPERTY_NAME + i, where
* i=1, 2,...
*
* @see u_getPropertyName()
* @see u_getPropertyValueName()
* @stable ICU 2.4
*/
UPropertyNameChoice :: enum u32 {
    SHORT_PROPERTY_NAME        :: 0;
    LONG_PROPERTY_NAME         :: 1;

    PROPERTY_NAME_CHOICE_COUNT :: 2;

    U_SHORT_PROPERTY_NAME        :: SHORT_PROPERTY_NAME;
    U_LONG_PROPERTY_NAME         :: LONG_PROPERTY_NAME;

    U_PROPERTY_NAME_CHOICE_COUNT :: PROPERTY_NAME_CHOICE_COUNT;
}

