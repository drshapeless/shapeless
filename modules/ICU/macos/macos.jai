*/
u_strFromUTF32_78 :: (dest: *UChar, destCapacity: s32, pDestLength: *s32, src: *UChar32, srcLength: s32, pErrorCode: *UErrorCode) -> *UChar #foreign libicuuc;

/**
* Convert a UTF-16 string to UTF-32.
