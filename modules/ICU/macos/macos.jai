*/
u_strToUTF32WithSub_78 :: (dest: *UChar32, destCapacity: s32, pDestLength: *s32, src: *UChar, srcLength: s32, subchar: UChar32, pNumSubstitutions: *s32, pErrorCode: *UErrorCode) -> *UChar32 #foreign libicuuc;

/**
