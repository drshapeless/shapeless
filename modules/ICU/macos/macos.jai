* @see u_strFromUTF32
* @stable ICU 2.0
*/
u_strToUTF32_78 :: (dest: *UChar32, destCapacity: s32, pDestLength: *s32, src: *UChar, srcLength: s32, pErrorCode: *UErrorCode) -> *UChar32 #foreign libicuuc;

/**
